---
import type { WallPhoto } from '../types/wall';

export interface Props {
  photos: WallPhoto[];
  /** 'full' fills the viewport; 'contained' fills its positioned parent. */
  variant?: 'full' | 'contained';
  label?: string;
  /** Slow self-panning (contained walls). */
  drift?: boolean;
  /** Muted presentation behind an overlay (404). */
  muted?: boolean;
  /** Non-interactive backdrop — no focus, pan, or lightbox. */
  decorative?: boolean;
  class?: string;
}

const {
  photos,
  variant = 'full',
  label = 'Muro de fotografías',
  drift = false,
  muted = false,
  decorative = false,
  class: className,
} = Astro.props;

// JSON inside <script> must not be able to close the tag.
const json = JSON.stringify(photos).replace(/</g, '\\u003c');
const hintId = `wall-hint-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={[
    'wall',
    `wall--${variant}`,
    muted && 'wall--muted',
    decorative && 'wall--decorative',
    className,
  ]}
  data-wall
  data-variant={variant}
  data-drift={drift && !decorative ? 'true' : undefined}
  data-capture-wheel={!decorative && variant === 'full' ? 'true' : 'false'}
  data-decorative={decorative ? 'true' : undefined}
  role={decorative ? 'presentation' : 'region'}
  aria-roledescription={decorative ? undefined : 'muro de fotografías'}
  aria-label={decorative ? undefined : label}
  aria-describedby={decorative ? undefined : hintId}
  aria-hidden={decorative ? 'true' : undefined}
  tabindex={decorative ? -1 : 0}
>
  {
    !decorative && (
      <p id={hintId} class="sr-only">
        Arrastra o usa las flechas del teclado para recorrer el muro. Enter abre la fotografía del
        centro.
      </p>
    )
  }
  <div class="wall-layer" data-wall-layer></div>
  <p class="sr-only" data-wall-live aria-live="polite" aria-atomic="true"></p>
  <script is:inline type="application/json" data-wall-data set:html={json} />
  {
    !decorative && (
      <ul class="sr-only">
        {photos.map((p) => (
          <li>{p.album ? `${p.album.title}: ${p.alt}` : p.alt}</li>
        ))}
      </ul>
    )
  }
  <noscript>
    <ul class="wall-fallback">
      {
        photos.map((p) => (
          <li>
            <img
              src={p.src}
              alt={decorative ? '' : p.alt}
              loading="lazy"
              decoding="async"
              crossorigin={p.src.startsWith('http') ? 'anonymous' : undefined}
            />
          </li>
        ))
      }
    </ul>
  </noscript>
</div>

<script>
  import { openLightbox } from '../scripts/lightbox';
  import { ProximityWall } from '../scripts/wall';
  import type { WallPhoto } from '../types/wall';

  let walls: ProximityWall[] = [];

  const fmt = (v: number) => {
    const n = Math.round(-v);
    return `${n < 0 ? '−' : '+'}${String(Math.abs(n)).padStart(4, '0')}`;
  };

  function mount() {
    unmount();
    document.querySelectorAll<HTMLElement>('[data-wall]').forEach((root) => {
      const raw = root.querySelector('[data-wall-data]')?.textContent;
      if (!raw) return;
      let photos: WallPhoto[];
      try {
        photos = JSON.parse(raw);
      } catch {
        return;
      }
      if (!photos.length) return;

      const decorative = root.dataset.decorative === 'true';
      const variant = root.dataset.variant === 'contained' ? 'contained' : 'full';
      const coords =
        !decorative && variant === 'full'
          ? document.querySelector<HTMLElement>('[data-wall-coords]')
          : null;
      const live = root.querySelector<HTMLElement>('[data-wall-live]');
      let lastCoords = '';
      let lastLive = '';

      walls.push(
        new ProximityWall(root, photos, {
          variant,
          drift: root.dataset.drift === 'true',
          captureWheel: root.dataset.captureWheel === 'true',
          interactive: !decorative,
          onOpen: decorative
            ? undefined
            : (index, rect, src) => openLightbox(photos, index, { rect, src, returnFocus: root }),
          onMove: coords
            ? (x, y) => {
                const text = `x ${fmt(x)} · y ${fmt(-y)}`;
                if (text !== lastCoords) {
                  lastCoords = text;
                  coords.textContent = text;
                }
              }
            : undefined,
          onCentre:
            !decorative && live
              ? (index, alt) => {
                  const text = `Centro: ${String(index + 1).padStart(2, '0')} — ${alt}`;
                  if (text === lastLive) return;
                  lastLive = text;
                  live.textContent = text;
                }
              : undefined,
        }),
      );
    });
  }

  function unmount() {
    walls.forEach((w) => w.destroy());
    walls = [];
  }

  mount();
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', unmount);
</script>

<style>
  .wall {
    position: relative;
    isolation: isolate;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .wall--full {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    touch-action: none;
    overscroll-behavior: contain;
    background: var(--color-paper);
    cursor: grab;
  }

  .wall--full:active {
    cursor: grabbing;
  }

  .wall--contained {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    touch-action: pan-y;
  }

  .wall--muted {
    filter: grayscale(0.35) brightness(0.92);
    opacity: 0.55;
  }

  .wall--decorative {
    pointer-events: none;
    cursor: default;
  }

  .wall-layer {
    position: absolute;
    inset: 0;
  }

  .wall-layer :global(.wall-tile) {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(26 26 26 / 0.05);
    transform: translate3d(var(--tx), var(--ty), 0) scale(var(--s, 1));
    transform-origin: center center;
  }

  .wall-layer :global(.wall-tile img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s var(--ease-folio);
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .wall-layer :global(.wall-tile.is-loaded img) {
    opacity: 1;
  }

  .wall-layer :global(.wall-cap) {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.35s ease,
      transform 0.45s var(--ease-folio);
    pointer-events: none;
  }

  .wall-layer :global(.wall-tile.is-focus .wall-cap) {
    opacity: 1;
    transform: none;
  }

  .wall-layer :global(.wall-cap-label) {
    font-family: var(--font-serif);
    font-size: clamp(13px, 1.4vw, 16px);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.45);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wall-layer :global(.wall-cap-num) {
    flex: none;
    padding: 3px 7px;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }

  .wall-fallback {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 8px;
    margin: 0;
    padding: 24px;
    list-style: none;
  }

  .wall-fallback img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .wall-layer :global(.wall-tile img),
    .wall-layer :global(.wall-cap) {
      transition: none;
    }
  }
</style>
