---
/** Shared folio viewer — driven by src/scripts/lightbox.ts. */
---

<div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Visor de fotografías">
  <div class="lb-scrim" data-lb-close></div>
  <div class="lb-stage" data-lb-stage>
    <img class="lb-img" data-lb-img alt="" decoding="async" draggable="false" />
    <p class="lb-loading label-mono" data-lb-loading><span></span>Revelando…</p>
  </div>

  <div class="lb-bar">
    <div class="lb-caption" aria-live="polite" aria-atomic="true">
      <span class="lb-count" data-lb-count>01 / 01</span>
      <span class="lb-title" data-lb-title></span>
      <span class="lb-alt" data-lb-alt></span>
    </div>

    <div class="lb-controls">
      <button type="button" class="lb-btn" data-lb-prev aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M14.5 6 8.5 12l6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        type="button"
        class="lb-btn lb-btn--close"
        data-lb-close
        data-lb-close-btn
        aria-label="Cerrar visor"
      >
        <span>Cerrar</span>
        <kbd>esc</kbd>
      </button>
      <button type="button" class="lb-btn" data-lb-next aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="m9.5 6 6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>

    <div class="lb-links">
      <a class="lb-album" data-lb-album href="/" hidden>
        <span>Ver álbum</span>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M5 12h14m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  .lb {
    position: fixed;
    inset: 0;
    overscroll-behavior: none;
    z-index: 80;
  }

  .lb[hidden] {
    display: none;
  }

  .lb-scrim {
    position: absolute;
    inset: 0;
    background: rgb(247 247 247 / 0.9);
    backdrop-filter: blur(18px) saturate(0.9);
    -webkit-backdrop-filter: blur(18px) saturate(0.9);
    opacity: 0;
    transition: opacity 0.45s var(--ease-folio);
  }

  .lb:global(.is-open) .lb-scrim {
    opacity: 1;
  }

  .lb-stage {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
  }

  .lb-img {
    position: fixed;
    object-fit: contain;
    transform-origin: 0 0;
    user-select: none;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.35);
    background: rgb(26 26 26 / 0.04);
  }

  .lb:global(.is-loading) .lb-img {
    opacity: 0;
  }

  .lb-loading {
    position: absolute;
    left: 50%;
    top: 45%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    translate: -50% -50%;
    color: var(--color-mute);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .lb-loading span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c4372b;
    animation: lb-pulse 1.1s ease-in-out infinite;
  }

  .lb:global(.is-loading) .lb-loading {
    opacity: 1;
    transition-delay: 0.15s;
  }

  @keyframes lb-pulse {
    50% {
      opacity: 0.25;
    }
  }

  .lb-bar {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 28px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 16px;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s ease 0.15s,
      transform 0.6s var(--ease-folio) 0.15s;
  }

  .lb:global(.is-open) .lb-bar {
    opacity: 1;
    transform: none;
  }

  .lb-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .lb-count {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-mute);
  }

  .lb-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 600;
    font-style: normal;
    letter-spacing: -0.025em;
    color: var(--color-ink);
  }

  .lb-alt {
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: 13.5px;
    font-style: normal;
    color: var(--color-ink-soft);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .lb-controls {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px;
    border-radius: 16px;
    background: var(--color-ink);
    color: #fff;
    box-shadow:
      rgb(0 0 0 / 0.34) 0 0.6px 0.6px -1.25px,
      rgb(0 0 0 / 0.3) 0 2.29px 2.29px -2.5px,
      rgb(0 0 0 / 0.12) 0 10px 10px -3.75px;
  }

  .lb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border-radius: 11px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .lb-btn[hidden] {
    display: none;
  }

  .lb-btn:hover {
    background: rgb(255 255 255 / 0.1);
  }

  .lb-btn svg {
    width: 20px;
    height: 20px;
  }

  .lb-btn kbd {
    padding: 2px 5px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.14);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lb-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 8px 16px;
  }

  .lb-album {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 12px;
    background: var(--color-card);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
    box-shadow:
      rgb(0 0 0 / 0.34) 0 0.6px 0.6px -1.25px,
      rgb(0 0 0 / 0.3) 0 2.29px 2.29px -2.5px,
      rgb(0 0 0 / 0.12) 0 10px 10px -3.75px;
    transition: transform 0.4s var(--ease-folio);
  }

  .lb-album[hidden] {
    display: none;
  }

  .lb-album:hover {
    transform: translateX(3px);
  }

  .lb-album svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 640px) {
    .lb-bar {
      left: 12px;
      right: 12px;
      bottom: 16px;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'caption links'
        'controls controls';
      row-gap: 12px;
    }

    .lb-caption {
      grid-area: caption;
    }

    .lb-links {
      grid-area: links;
    }

    .lb-controls {
      grid-area: controls;
      justify-self: center;
    }

    .lb-btn kbd {
      display: none;
    }
  }

  :global(html.lb-open) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .lb,
    .lb-scrim,
    .lb-bar,
    .lb-img,
    .lb-btn,
    .lb-album,
    .lb-loading span {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
