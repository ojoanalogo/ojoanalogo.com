---
import site from "../data/site.json";

const year = new Date().getFullYear();
---

<footer class="site-footer grid-12 page-pad">
  <div class="footer-col">
    <p class="label">Contacto</p>
    <a class="link-quiet" href="mailto:hola@ojoanalogo.com">hola@ojoanalogo.com</a>
  </div>

  <div class="footer-col">
    <p class="label">Archivo</p>
    <a class="link-quiet" href="/indice">Índice de álbumes</a>
    <a class="link-quiet" href="/about">Sobre mí</a>
  </div>

  <div class="footer-col">
    <p class="label">En otros lados</p>
    <a class="link-quiet" href="https://www.instagram.com/ojo.analogo" target="_blank" rel="noreferrer">
      Instagram
    </a>
    <a class="link-quiet" href="https://alfon.so" target="_blank" rel="noreferrer">Mi otro yo</a>
  </div>

  <div class="footer-col">
    <p class="label">© {year} {site.title}</p>
    <span>ojoanalogo</span>
    <span>Hecho con película</span>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(80px, 12vw, 160px);
    padding-bottom: var(--gutter);
    row-gap: 32px;
  }

  .footer-col {
    grid-column: span 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .footer-col p {
    margin: 0;
  }

  @media (max-width: 767px) {
    .footer-col {
      grid-column: span 6;
    }
  }
</style>
