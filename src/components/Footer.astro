---
import IconInstagram from "./IconInstagram.astro";
import site from "../data/site.json";

const { compact = false } = Astro.props;
---

<footer class:list={[compact ? "py-2" : ""]}>
  <div class:list={["max-w-screen-xl mx-auto", compact ? "py-2" : "py-8"]}>
    <div class="grid grid-cols-1 text-center mx-auto text-gray-600">
      {
        compact ? (
          <div class="flex items-center justify-center gap-3 text-sm">
            <p class="font-display text-base m-0">{site.title}</p>
            <span class="opacity-30" aria-hidden="true">
              ·
            </span>
            <a
              class="font-body font-light hover:opacity-75 transition"
              href="mailto:hola@ojoanalogo.com"
            >
              hola@ojoanalogo.com
            </a>
            <span class="opacity-30" aria-hidden="true">
              ·
            </span>
            <a
              class="transition duration-300 hover:opacity-75"
              href="https://www.instagram.com/ojo.analogo"
              target="_blank"
              rel="noreferrer"
            >
              <span class="sr-only">Instagram</span>
              <IconInstagram class="w-4 h-4" />
            </a>
          </div>
        ) : (
          <>
            <p class="font-display text-xl">{site.title}</p>
            <p class="text-sm font-body font-light">
              <a href="mailto:hola@ojoanalogo.com">hola@ojoanalogo.com</a>
            </p>
            <div class="flex mx-auto justify-center mt-2">
              <a
                class="transition duration-300 hover:opacity-75"
                href="https://www.instagram.com/ojo.analogo"
                target="_blank"
                rel="noreferrer"
              >
                <span class="sr-only">Instagram</span>
                <IconInstagram class="w-6 h-6" />
              </a>
            </div>
          </>
        )
      }
    </div>
  </div>
</footer>
