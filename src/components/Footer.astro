---
import IconInstagram from './IconInstagram.astro';
import Mark from './Mark.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="site-foot">
  <div class="site-foot-inner">
    <a href="/" class="site-foot-brand">
      <Mark size={20} />
      <span>{site.title}</span>
    </a>
    <div class="site-foot-links">
      <a href="mailto:hola@ojoanalogo.com">hola@ojoanalogo.com</a>
      <a
        href="https://www.instagram.com/ojo.analogo/"
        target="_blank"
        rel="noreferrer"
        class="inline-flex items-center gap-1.5"
        aria-label="Instagram de ojo.analogo (se abre en una pestaña nueva)"
      >
        <IconInstagram class="h-3.5 w-3.5" />
        Instagram
      </a>
      <span class="label-mono text-mute">© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    padding: 48px 24px 32px;
  }

  .site-foot-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    max-width: 1280px;
    margin: 0 auto;
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }

  .site-foot-brand {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .site-foot-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-soft);
  }

  .site-foot-links a:hover {
    color: var(--color-ink);
  }
</style>
