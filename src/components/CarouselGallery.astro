---
import { Image } from "astro:assets";
import type { Photo } from "../types/photos";

export interface Props {
  photos: Array<Photo>;
  randomize?: boolean;
}

const { photos, randomize = false } = Astro.props;
const totalSlides = photos?.length ?? 0;
---

<div class="gallery-showcase">
  <div class="gallery-wall">
    <div class="spotlight" aria-hidden="true"></div>

    <div class="swiper showcase-swiper" data-randomize={randomize}>
      <div class="swiper-wrapper">
        {
          photos?.map(async (photo: Photo, index: number) => {
            const fileName = photo.src.src.split("/").pop();

            return (
              <div class="swiper-slide">
                <div class="slide-stage">
                  <a
                    class="art-piece"
                    data-umami-event="Carousel photo click"
                    data-umami-event-photo-id={fileName}
                  >
                    <div class="frame-outer">
                      <div class="frame-mat">
                        <div class="frame-inner">
                          <Image
                            class="framed-photo"
                            src={photo.src}
                            decoding="async"
                            loading={index === 0 ? "eager" : "lazy"}
                            alt={photo.alt}
                            widths={[400, 700, 900, 1400, 1800]}
                            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 70vw, 60vw"
                            quality={"high"}
                          />
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>

      <div class="navigation-controls hidden lg:flex">
        <div class="swiper-button-prev nav-arrow" aria-label="Previous image">
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        </div>
        <div class="swiper-button-next nav-arrow" aria-label="Next image">
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </div>
    </div>

    {totalSlides > 1 && (
      <div class="slide-counter" aria-live="polite">
        <span class="current-slide">1</span>
        <span class="counter-separator">/</span>
        <span class="total-slides">{totalSlides}</span>
      </div>
    )}
  </div>
</div>

<script>
  import Swiper from "swiper";
  import "swiper/css";
  import "swiper/css/effect-fade";
  import "swiper/css/navigation";
  import { Autoplay, EffectFade, Keyboard, Navigation } from "swiper/modules";

  let swiperInstance: Swiper | null = null;

  const shuffleArray = <T,>(array: T[]): void => {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
  };

  const shuffleSlides = (container: HTMLElement): void => {
    const wrapper = container.querySelector(".swiper-wrapper");
    if (!wrapper) return;

    const slides = Array.from(wrapper.children);
    shuffleArray(slides);
    slides.forEach((slide) => wrapper.appendChild(slide));
  };

  const destroySwiper = (): void => {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  };

  const createSwiperConfig = (counterEl: Element | null) => ({
    modules: [EffectFade, Navigation, Autoplay, Keyboard],
    effect: "fade",
    fadeEffect: { crossFade: true },
    speed: 900,
    allowTouchMove: true,
    loop: true,
    autoplay: {
      delay: 8000,
      disableOnInteraction: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    keyboard: { enabled: true },
    on: {
      slideChange: (swiper: Swiper) => {
        if (counterEl) {
          counterEl.textContent = (swiper.realIndex + 1).toString();
        }
      },
    },
  });

  const initSwiper = (): void => {
    destroySwiper();

    const swiperContainer = document.querySelector(".showcase-swiper") as HTMLElement;
    if (!swiperContainer) return;

    if (swiperContainer.dataset.randomize === "true") {
      shuffleSlides(swiperContainer);
    }

    const counterEl = document.querySelector(".current-slide");
    swiperInstance = new Swiper(".showcase-swiper", createSwiperConfig(counterEl));
  };

  const setupSwiperInitialization = (): void => {
    document.addEventListener("astro:page-load", initSwiper);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSwiper);
    } else {
      initSwiper();
    }
  };

  setupSwiperInitialization();
</script>

<style>
  :root {
    --swiper-navigation-size: 0;
    --gallery-wall: #2c2824;
    --frame-wood: #3d2e22;
    --frame-wood-light: #5a4535;
    --mat-color: #f0ebe3;
    --mat-shadow: #d4cdc3;
  }

  .gallery-showcase {
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .gallery-wall {
    position: relative;
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border-radius: 2px;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255, 248, 235, 0.06) 0%, transparent 60%),
      linear-gradient(180deg, #35302b 0%, var(--gallery-wall) 40%, #1f1c19 100%);
    box-shadow:
      inset 0 0 80px rgba(0, 0, 0, 0.4),
      0 8px 32px rgba(0, 0, 0, 0.15);
  }

  .spotlight {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      ellipse 55% 45% at 50% 38%,
      rgba(255, 248, 235, 0.12) 0%,
      transparent 70%
    );
  }

  .showcase-swiper {
    flex: 1;
    min-height: 0;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  .swiper-wrapper,
  .swiper-slide {
    height: 100%;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slide-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 1.5rem 1rem 2.5rem;
  }

  .art-piece {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(90vw, 1100px);
    max-height: 100%;
    text-decoration: none;
    cursor: default;
    transition: transform 0.6s ease;
  }

  /* Outer wooden frame */
  .frame-outer {
    padding: 10px;
    background: linear-gradient(
      145deg,
      var(--frame-wood-light) 0%,
      var(--frame-wood) 30%,
      #2a1f17 70%,
      var(--frame-wood) 100%
    );
    box-shadow:
      0 2px 0 rgba(255, 255, 255, 0.08) inset,
      0 -2px 0 rgba(0, 0, 0, 0.3) inset,
      0 12px 40px rgba(0, 0, 0, 0.45),
      0 4px 12px rgba(0, 0, 0, 0.3);
    max-height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Mat (passe-partout) */
  .frame-mat {
    padding: clamp(12px, 2.5vw, 28px);
    background: linear-gradient(160deg, var(--mat-color) 0%, var(--mat-shadow) 100%);
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.06),
      inset 0 2px 4px rgba(0, 0, 0, 0.04);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .frame-inner {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #1a1816;
    box-shadow: inset 0 0 12px rgba(0, 0, 0, 0.25);
  }

  .framed-photo {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 16rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Slide counter */
  .slide-counter {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: "Oranienbaum", Georgia, serif;
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    color: rgba(240, 235, 228, 0.5);
    pointer-events: none;
    user-select: none;
  }

  .counter-separator {
    margin: 0 0.25em;
    opacity: 0.4;
  }

  /* Navigation */
  .swiper-button-next::after,
  .swiper-button-prev::after {
    display: none;
  }

  .navigation-controls {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    background-color: rgba(240, 235, 228, 0.12);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(240, 235, 228, 0.15);
    border-radius: 50%;
    min-width: 48px;
    min-height: 48px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    pointer-events: auto;
    cursor: pointer;
  }

  .nav-arrow:hover {
    background-color: rgba(240, 235, 228, 0.22);
    border-color: rgba(240, 235, 228, 0.3);
  }

  .swiper-button-prev {
    left: 1.5rem;
  }

  .swiper-button-next {
    right: 1.5rem;
  }

  .arrow-icon {
    width: 24px;
    height: 24px;
    color: rgba(240, 235, 228, 0.7);
    flex-shrink: 0;
  }

  /* Active slide entrance animation */
  .swiper-slide-active .art-piece {
    animation: frameReveal 0.8s ease-out;
  }

  @keyframes frameReveal {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (max-width: 1024px) {
    .nav-arrow {
      min-width: 44px;
      min-height: 44px;
      width: 44px;
      height: 44px;
    }

    .arrow-icon {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 768px) {
    .nav-arrow {
      display: none !important;
    }

    .slide-stage {
      padding: 1rem 0.5rem 2rem;
    }

    .frame-outer {
      padding: 7px;
    }

    .framed-photo {
      max-height: calc(100dvh - 14rem);
    }
  }

  @media (min-height: 900px) {
    .framed-photo {
      max-height: calc(100dvh - 18rem);
    }
  }
</style>
