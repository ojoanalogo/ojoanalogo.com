---
import { Image } from "astro:assets";
import type { Photo } from "../types/photos";

export interface Props {
  photos: Array<Photo>;
  randomize?: boolean;
}

const { photos, randomize = false } = Astro.props;
const total = photos?.length ?? 0;
---

<section
  class="gallery-hall"
  aria-roledescription="carousel"
  aria-label="Galería destacada"
>
  <div class="gallery-stage">
    <div class="swiper showcase-swiper" data-randomize={randomize} data-total={total}>
      <div class="swiper-wrapper">
        {
          photos?.map(async (photo: Photo, index: number) => {
            const fileName = photo.src.src.split("/").pop();

            return (
              <div
                class="swiper-slide"
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} de ${total}`}
              >
                <figure class="artwork-frame">
                  <div class="frame-rail">
                    <div class="frame-mat">
                      <a
                        class="artwork-link"
                        data-umami-event="Carousel photo click"
                        data-umami-event-photo-id={fileName}
                      >
                        <Image
                          class="artwork"
                          src={photo.src}
                          decoding="async"
                          loading={index === 0 ? "eager" : "lazy"}
                          alt={photo.alt}
                          widths={[400, 700, 900, 1400, 1800]}
                          sizes="(max-width: 768px) 92vw, (max-width: 1280px) 80vw, 1200px"
                          quality={"high"}
                        />
                      </a>
                    </div>
                  </div>
                </figure>
              </div>
            );
          })
        }
      </div>

      <div class="navigation-controls hidden lg:block">
        <button
          type="button"
          class="swiper-button-prev nav-arrow"
          aria-label="Obra anterior"
        >
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button
          type="button"
          class="swiper-button-next nav-arrow"
          aria-label="Obra siguiente"
        >
          <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="gallery-plaque">
    <p class="plaque-counter" aria-live="polite">
      <span class="current-slide">1</span>
      <span class="plaque-sep" aria-hidden="true">—</span>
      <span class="total-slides">{total}</span>
    </p>
    <div class="progress-track" aria-hidden="true">
      <div class="progress-fill"></div>
    </div>
  </div>
</section>

<script>
  import Swiper from "swiper";
  import "swiper/css";
  import "swiper/css/effect-fade";
  import "swiper/css/navigation";
  import { Autoplay, EffectFade, Keyboard, Navigation } from "swiper/modules";

  let swiperInstance: InstanceType<typeof Swiper> | null = null;
  let progressRaf: number | null = null;
  let progressStartedAt = 0;
  let progressDelay = 8000;
  let stageObserver: ResizeObserver | null = null;

  const shuffleArray = <T,>(array: T[]) => {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
  };

  const shuffleSlides = (container: HTMLElement) => {
    const wrapper = container.querySelector(".swiper-wrapper");
    if (!wrapper) return;

    const slides = Array.from(wrapper.children);
    shuffleArray(slides);
    slides.forEach((slide) => wrapper.appendChild(slide));
  };

  const syncStageMetrics = (hall: HTMLElement, stage: HTMLElement) => {
    const rect = stage.getBoundingClientRect();
    // Leave room for frame rail + mat so the photo itself never clips
    const chrome = window.matchMedia("(max-height: 720px)").matches ? 40 : 64;
    const photoMaxH = Math.max(120, Math.floor(rect.height - chrome));
    const photoMaxW = Math.max(120, Math.floor(rect.width - chrome));
    hall.style.setProperty("--photo-max-h", `${photoMaxH}px`);
    hall.style.setProperty("--photo-max-w", `${photoMaxW}px`);
  };

  const bindStageObserver = (hall: HTMLElement) => {
    const stage = hall.querySelector(".gallery-stage") as HTMLElement | null;
    if (!stage) return;

    syncStageMetrics(hall, stage);
    stageObserver?.disconnect();
    stageObserver = new ResizeObserver(() => syncStageMetrics(hall, stage));
    stageObserver.observe(stage);
  };

  const destroySwiper = () => {
    if (progressRaf !== null) {
      cancelAnimationFrame(progressRaf);
      progressRaf = null;
    }
    stageObserver?.disconnect();
    stageObserver = null;
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  };

  const runProgress = (
    swiper: InstanceType<typeof Swiper>,
    progressFill: HTMLElement | null,
  ) => {
    if (!progressFill) return;

    progressDelay =
      typeof swiper.params.autoplay === "object"
        ? Number(swiper.params.autoplay.delay) || 8000
        : 8000;

    progressStartedAt = performance.now();
    progressFill.style.transform = "scaleX(0)";

    const tick = (now: number) => {
      const autoplay = swiper.autoplay;
      if (!autoplay?.running || autoplay.paused) {
        progressRaf = requestAnimationFrame(tick);
        return;
      }

      const ratio = Math.min((now - progressStartedAt) / progressDelay, 1);
      progressFill.style.transform = `scaleX(${ratio})`;
      progressRaf = requestAnimationFrame(tick);
    };

    if (progressRaf !== null) cancelAnimationFrame(progressRaf);
    progressRaf = requestAnimationFrame(tick);
  };

  const createSwiperConfig = (
    counterEl: Element | null,
    progressFill: HTMLElement | null,
  ) => ({
    modules: [EffectFade, Navigation, Autoplay, Keyboard],
    effect: "fade" as const,
    fadeEffect: { crossFade: true },
    speed: 1100,
    allowTouchMove: true,
    loop: true,
    autoplay: {
      delay: 8000,
      disableOnInteraction: false,
      pauseOnMouseEnter: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    keyboard: { enabled: true },
    on: {
      init(swiper: InstanceType<typeof Swiper>) {
        if (counterEl) counterEl.textContent = String(swiper.realIndex + 1);
        runProgress(swiper, progressFill);
      },
      slideChange(swiper: InstanceType<typeof Swiper>) {
        if (counterEl) counterEl.textContent = String(swiper.realIndex + 1);
        runProgress(swiper, progressFill);
      },
      autoplayStop() {
        if (progressFill) progressFill.style.transform = "scaleX(0)";
      },
    },
  });

  const initSwiper = () => {
    destroySwiper();

    const swiperContainer = document.querySelector(
      ".showcase-swiper",
    ) as HTMLElement | null;
    if (!swiperContainer) return;

    if (swiperContainer.dataset.randomize === "true") {
      shuffleSlides(swiperContainer);
    }

    const hall = swiperContainer.closest(".gallery-hall") as HTMLElement | null;
    if (hall) bindStageObserver(hall);

    const counterEl =
      hall?.querySelector(".current-slide") ??
      document.querySelector(".current-slide");
    const progressFill = hall?.querySelector(
      ".progress-fill",
    ) as HTMLElement | null;

    swiperInstance = new Swiper(
      ".showcase-swiper",
      createSwiperConfig(counterEl, progressFill),
    );
  };

  const setupSwiperInitialization = () => {
    document.addEventListener("astro:page-load", initSwiper);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSwiper);
    } else {
      initSwiper();
    }
  };

  setupSwiperInitialization();
</script>

<style>
  .gallery-hall {
    --frame-ink: #2c2621;
    --frame-lip: #1a1613;
    --mat: #f3eee6;
    --wall-deep: #ebe4d8;
    --wall-light: #f7f3ec;
    --plaque: #6d5f4e;
    /* Safe defaults before ResizeObserver measures the stage */
    --photo-max-h: calc(100dvh - 10.5rem);
    --photo-max-w: min(92vw, 1180px);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 0;
    isolation: isolate;
  }

  .gallery-hall::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 42%,
        rgba(255, 255, 255, 0.55),
        transparent 70%
      ),
      linear-gradient(180deg, var(--wall-light) 0%, var(--wall-deep) 100%);
    opacity: 0.9;
    pointer-events: none;
  }

  .gallery-stage {
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    position: relative;
  }

  .showcase-swiper {
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .swiper {
    height: 100% !important;
    width: 100% !important;
    overflow: hidden;
  }

  .swiper-wrapper {
    height: 100% !important;
  }

  .swiper-slide {
    height: 100% !important;
    box-sizing: border-box;
    display: flex !important;
    align-items: center;
    justify-content: center;
    padding: 0.25rem 0.35rem;
  }

  .artwork-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    height: fit-content;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
    animation: hangIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .frame-rail {
    display: flex;
    box-sizing: border-box;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    padding: clamp(0.28rem, 0.65vw, 0.55rem);
    background: linear-gradient(
      145deg,
      #3a322b 0%,
      var(--frame-ink) 40%,
      var(--frame-lip) 100%
    );
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.12) inset,
      0 -1px 0 rgba(0, 0, 0, 0.35) inset,
      0 18px 40px rgba(44, 38, 33, 0.18),
      0 4px 10px rgba(44, 38, 33, 0.12);
  }

  .frame-mat {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    padding: clamp(0.45rem, 1.4vw, 1.25rem);
    background: var(--mat);
    box-shadow: inset 0 0 0 1px rgba(44, 38, 33, 0.06);
  }

  .artwork-link {
    display: block;
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
    line-height: 0;
  }

  /* Live stage metrics keep the full photo visible as height changes */
  .artwork {
    display: block;
    width: auto;
    height: auto;
    max-width: var(--photo-max-w);
    max-height: var(--photo-max-h);
    object-fit: contain;
  }

  .gallery-plaque {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 0 0.25rem;
  }

  .plaque-counter {
    margin: 0;
    font-family: theme("fontFamily.display");
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--plaque);
    opacity: 0.85;
  }

  .plaque-sep {
    margin: 0 0.55rem;
    opacity: 0.55;
  }

  .progress-track {
    width: min(8rem, 30vw);
    height: 1px;
    background: rgba(109, 95, 78, 0.2);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    width: 100%;
    transform-origin: left center;
    transform: scaleX(0);
    background: rgba(109, 95, 78, 0.75);
    will-change: transform;
  }

  :global(:root) {
    --swiper-navigation-size: 0;
  }

  .swiper-button-next::after,
  .swiper-button-prev::after {
    display: none;
  }

  .navigation-controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 10;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    background-color: rgba(247, 243, 236, 0.55);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(44, 38, 33, 0.08);
    border-radius: 9999px;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease,
      opacity 0.3s ease;
    pointer-events: auto;
    padding: 0;
    cursor: pointer;
    color: var(--frame-ink);
    opacity: 0.7;
  }

  .nav-arrow:hover {
    background-color: rgba(247, 243, 236, 0.9);
    opacity: 1;
  }

  .nav-arrow:active {
    transform: translateY(-50%) scale(0.96);
  }

  .swiper-button-prev {
    left: clamp(0.5rem, 2vw, 1.75rem);
  }

  .swiper-button-next {
    right: clamp(0.5rem, 2vw, 1.75rem);
  }

  .arrow-icon {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .nav-arrow {
      display: none;
    }
  }

  @media (max-height: 720px) {
    .gallery-hall {
      --photo-max-h: calc(100dvh - 8.75rem);
    }

    .frame-mat {
      padding: clamp(0.3rem, 0.9vw, 0.65rem);
    }

    .frame-rail {
      padding: 0.22rem;
    }

    .gallery-plaque {
      padding-top: 0.45rem;
      gap: 0.4rem;
    }
  }

  @media (max-height: 560px) {
    .gallery-hall {
      --photo-max-h: calc(100dvh - 7.25rem);
    }

    .gallery-plaque {
      padding-top: 0.3rem;
    }

    .plaque-counter {
      font-size: 0.8rem;
    }
  }

  @keyframes hangIn {
    from {
      opacity: 0;
      transform: translateY(0.75rem) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .artwork-frame {
      animation: none;
    }
  }
</style>
