---
import type { Photo } from "../types/photos";
import { optimizeDisplayPhoto } from "../utils/optimizePhoto";

export interface Props {
  photos: Array<Photo>;
  randomize?: boolean;
}

const { photos, randomize = false } = Astro.props;
const totalSlides = photos?.length ?? 0;

const slides = await Promise.all(
  (photos ?? []).map(async (photo) => {
    const fileName =
      typeof photo.src === "string"
        ? photo.src.split("/").pop()?.split("?")[0] ?? "photo"
        : photo.src.src.split("/").pop() ?? "";
    const sources = await optimizeDisplayPhoto(photo.src, "(max-width: 768px) 90vw, (max-width: 1280px) 70vw, 60vw");
    return { ...sources, alt: photo.alt, fileName };
  }),
);
---

<div class="gallery-showcase">
  <div class="swiper showcase-swiper" data-randomize={randomize}>
    <div class="swiper-wrapper">
      {
        slides.map((slide) => (
          <div class="swiper-slide">
            <div class="slide-stage">
              <a
                class="art-piece"
                data-umami-event="Carousel photo click"
                data-umami-event-photo-id={slide.fileName}
              >
                <picture>
                  <source
                    type="image/avif"
                    data-srcset={slide.avifSrcSet}
                    sizes={slide.sizes}
                  />
                  <source
                    type="image/webp"
                    data-srcset={slide.webpSrcSet}
                    sizes={slide.sizes}
                  />
                  <img
                    class="showcase-photo"
                    data-src={slide.webpSrc}
                    data-srcset={slide.webpSrcSet}
                    data-sizes={slide.sizes}
                    width={slide.width}
                    height={slide.height}
                    alt={slide.alt}
                    decoding="async"
                    draggable="false"
                  />
                </picture>
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <div class="navigation-controls hidden lg:flex">
      <div class="swiper-button-prev nav-arrow" aria-label="Previous image">
        <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </div>
      <div class="swiper-button-next nav-arrow" aria-label="Next image">
        <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>

  {totalSlides > 1 && (
    <div class="slide-counter" aria-live="polite">
      <span class="current-slide">1</span>
      <span class="counter-separator">/</span>
      <span class="total-slides">{totalSlides}</span>
    </div>
  )}
</div>

<script>
  import Swiper from "swiper";
  import "swiper/css";
  import "swiper/css/effect-fade";
  import "swiper/css/navigation";
  import { Autoplay, EffectFade, Keyboard, Navigation } from "swiper/modules";

  let swiperInstance: Swiper | null = null;
  let lastSpeed = 0;

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const shuffleArray = <T,>(array: T[]): void => {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
  };

  const shuffleSlides = (container: HTMLElement): void => {
    const wrapper = container.querySelector(".swiper-wrapper");
    if (!wrapper) return;

    const slides = Array.from(wrapper.children);
    shuffleArray(slides);
    slides.forEach((slide) => wrapper.appendChild(slide));
  };

  /** Only hydrate active ± neighbors — fade/walk slides share the viewport so native lazy fails */
  const hydrateSlide = (slide: Element | null | undefined, eager = false): void => {
    if (!slide) return;
    const picture = slide.querySelector("picture");
    const img = slide.querySelector("img.showcase-photo") as HTMLImageElement | null;
    if (!img || img.dataset.hydrated === "true") return;

    picture?.querySelectorAll("source[data-srcset]").forEach((source) => {
      const el = source as HTMLSourceElement;
      el.srcset = el.dataset.srcset || "";
      el.removeAttribute("data-srcset");
    });

    if (img.dataset.srcset) {
      img.srcset = img.dataset.srcset;
      img.removeAttribute("data-srcset");
    }
    if (img.dataset.sizes) {
      img.sizes = img.dataset.sizes;
      img.removeAttribute("data-sizes");
    }
    if (img.dataset.src) {
      img.src = img.dataset.src;
      img.removeAttribute("data-src");
    }

    if (eager) img.setAttribute("fetchpriority", "high");
    img.dataset.hydrated = "true";
    img.classList.add("is-hydrated");
  };

  const hydrateAround = (swiper: Swiper): void => {
    const slides = swiper.slides;
    if (!slides?.length) return;

    const active = swiper.activeIndex;
    const indexes = new Set<number>([active]);
    indexes.add((active + 1) % slides.length);
    indexes.add((active - 1 + slides.length) % slides.length);
    indexes.forEach((i) => hydrateSlide(slides[i], i === active));
  };

  const destroySwiper = (): void => {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  };

  const applyMotion = (swiper: Swiper, dir: "next" | "prev"): void => {
    if (lastSpeed === 0) return;

    const el = swiper.el as HTMLElement;
    const useWalk = !prefersReducedMotion();
    el.dataset.motion = useWalk ? "walk" : "fade";
    el.dataset.dir = dir;

    if (useWalk) {
      // Swiper types omit setTransition; runtime API is stable.
      (swiper as Swiper & { setTransition: (duration: number) => void }).setTransition(1250);
    }
  };

  const clearMotion = (swiper: Swiper): void => {
    const el = swiper.el as HTMLElement;
    el.removeAttribute("data-motion");
    el.removeAttribute("data-dir");
  };

  const createSwiperConfig = (counterEl: Element | null) => ({
    modules: [EffectFade, Navigation, Autoplay, Keyboard],
    effect: "fade" as const,
    fadeEffect: { crossFade: true },
    speed: 1250,
    allowTouchMove: true,
    followFinger: false,
    loop: true,
    autoplay: {
      delay: 8000,
      disableOnInteraction: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    keyboard: { enabled: true },
    on: {
      init: (swiper: Swiper) => {
        hydrateAround(swiper);
      },
      beforeTransitionStart: (_swiper: Swiper, speed: number) => {
        lastSpeed = speed;
      },
      slideNextTransitionStart: (swiper: Swiper) => applyMotion(swiper, "next"),
      slidePrevTransitionStart: (swiper: Swiper) => applyMotion(swiper, "prev"),
      transitionEnd: (swiper: Swiper) => clearMotion(swiper),
      slideChange: (swiper: Swiper) => {
        hydrateAround(swiper);
        if (counterEl) {
          counterEl.textContent = (swiper.realIndex + 1).toString();
        }
      },
    },
  });

  const initSwiper = (): void => {
    destroySwiper();
    lastSpeed = 0;

    const swiperContainer = document.querySelector(".showcase-swiper") as HTMLElement;
    if (!swiperContainer) return;

    if (swiperContainer.dataset.randomize === "true") {
      shuffleSlides(swiperContainer);
    }

    // Hydrate the post-shuffle first slide ASAP
    hydrateSlide(swiperContainer.querySelector(".swiper-slide"), true);

    const counterEl = document.querySelector(".current-slide");
    swiperInstance = new Swiper(".showcase-swiper", createSwiperConfig(counterEl));
  };

  const setupSwiperInitialization = (): void => {
    document.addEventListener("astro:page-load", initSwiper);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSwiper);
    } else {
      initSwiper();
    }
  };

  setupSwiperInitialization();
</script>

<style>
  :root {
    --swiper-navigation-size: 0;
  }

  .gallery-showcase {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .showcase-swiper {
    flex: 1;
    min-height: 0;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .swiper-wrapper,
  .swiper-slide {
    height: 100%;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .slide-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 1.5rem 1rem 2.5rem;
  }

  .art-piece {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(92vw, 1200px);
    max-height: 100%;
    text-decoration: none;
    cursor: default;
    will-change: transform;
  }

  .showcase-photo {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 14rem);
    width: auto;
    height: auto;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .showcase-photo.is-hydrated {
    opacity: 1;
  }

  /* Side-to-side gallery walk for autoplay, arrows, keyboard, and swipe. */
  .showcase-swiper[data-motion="walk"] .swiper-slide-active,
  .showcase-swiper[data-motion="walk"] .swiper-slide-prev,
  .showcase-swiper[data-motion="walk"] .swiper-slide-next {
    opacity: 1 !important;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-next,
  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-prev {
    opacity: 0 !important;
    visibility: hidden;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-prev {
    z-index: 1;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-active {
    z-index: 2;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-next {
    z-index: 1;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-active {
    z-index: 2;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-prev .art-piece {
    animation: walk-out-left 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-active .art-piece {
    animation: walk-in-from-right 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-next .art-piece {
    animation: walk-out-right 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-active .art-piece {
    animation: walk-in-from-left 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  @keyframes walk-out-left {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 5rem)); }
  }

  @keyframes walk-in-from-right {
    from { transform: translateX(calc(100% + 5rem)); }
    to { transform: translateX(0); }
  }

  @keyframes walk-out-right {
    from { transform: translateX(0); }
    to { transform: translateX(calc(100% + 5rem)); }
  }

  @keyframes walk-in-from-left {
    from { transform: translateX(calc(-100% - 5rem)); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-piece {
      animation: none !important;
    }

    .showcase-photo {
      transition: none;
      opacity: 1;
    }
  }

  .slide-counter {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: "Oranienbaum", Georgia, serif;
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    color: #a08a70;
    pointer-events: none;
    user-select: none;
  }

  .counter-separator {
    margin: 0 0.25em;
    opacity: 0.4;
  }

  .swiper-button-next::after,
  .swiper-button-prev::after {
    display: none;
  }

  .navigation-controls {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    background-color: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
    border: none;
    border-radius: 50%;
    min-width: 48px;
    min-height: 48px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    pointer-events: auto;
    cursor: pointer;
  }

  .nav-arrow:hover {
    background-color: rgba(255, 255, 255, 0.5);
  }

  .swiper-button-prev {
    left: 1.5rem;
  }

  .swiper-button-next {
    right: 1.5rem;
  }

  .arrow-icon {
    width: 24px;
    height: 24px;
    color: #262626;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .nav-arrow {
      min-width: 44px;
      min-height: 44px;
      width: 44px;
      height: 44px;
    }

    .arrow-icon {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 768px) {
    .nav-arrow {
      display: none !important;
    }

    .slide-stage {
      padding: 1rem 0.5rem 2rem;
    }

    .showcase-photo {
      max-height: calc(100dvh - 12rem);
    }
  }

  @media (min-height: 900px) {
    .showcase-photo {
      max-height: calc(100dvh - 16rem);
    }
  }
</style>
