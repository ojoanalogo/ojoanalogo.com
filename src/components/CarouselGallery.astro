---
import { Image } from "astro:assets";
import type { Photo } from "../types/photos";

export interface Props {
  photos: Array<Photo>;
  randomize?: boolean;
}

const { photos, randomize = false } = Astro.props;
const totalSlides = photos?.length ?? 0;
---

<div class="gallery-showcase">
  <div class="swiper showcase-swiper" data-randomize={randomize}>
    <div class="swiper-wrapper">
      {
        photos?.map(async (photo: Photo, index: number) => {
          const fileName = photo.src.src.split("/").pop();

          return (
            <div class="swiper-slide">
              <div class="slide-stage">
                <a
                  class="art-piece"
                  data-umami-event="Carousel photo click"
                  data-umami-event-photo-id={fileName}
                >
                  <div class="frame-outer">
                    <div class="frame-fillet">
                      <div class="frame-mat">
                        <div class="frame-window">
                          <Image
                            class="framed-photo"
                            src={photo.src}
                            decoding="async"
                            loading={index === 0 ? "eager" : "lazy"}
                            alt={photo.alt}
                            widths={[400, 700, 900, 1400, 1800]}
                            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 70vw, 60vw"
                            quality={"high"}
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            </div>
          );
        })
      }
    </div>

    <div class="navigation-controls hidden lg:flex">
      <div class="swiper-button-prev nav-arrow" aria-label="Previous image">
        <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </div>
      <div class="swiper-button-next nav-arrow" aria-label="Next image">
        <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>

  {totalSlides > 1 && (
    <div class="slide-counter" aria-live="polite">
      <span class="current-slide">1</span>
      <span class="counter-separator">/</span>
      <span class="total-slides">{totalSlides}</span>
    </div>
  )}
</div>

<script>
  import Swiper from "swiper";
  import "swiper/css";
  import "swiper/css/effect-fade";
  import "swiper/css/navigation";
  import { Autoplay, EffectFade, Keyboard, Navigation } from "swiper/modules";

  let swiperInstance: Swiper | null = null;
  let pendingWalk = false;

  const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const shuffleArray = <T,>(array: T[]): void => {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
  };

  const shuffleSlides = (container: HTMLElement): void => {
    const wrapper = container.querySelector(".swiper-wrapper");
    if (!wrapper) return;

    const slides = Array.from(wrapper.children);
    shuffleArray(slides);
    slides.forEach((slide) => wrapper.appendChild(slide));
  };

  const destroySwiper = (): void => {
    if (swiperInstance) {
      swiperInstance.destroy(true, true);
      swiperInstance = null;
    }
  };

  const applyMotion = (swiper: Swiper, dir: "next" | "prev"): void => {
    const el = swiper.el as HTMLElement;
    const useWalk = pendingWalk && !prefersReducedMotion();
    el.dataset.motion = useWalk ? "walk" : "fade";
    el.dataset.dir = dir;

    if (useWalk) {
      swiper.setTransition(1250);
    }
  };

  const clearMotion = (swiper: Swiper): void => {
    const el = swiper.el as HTMLElement;
    el.removeAttribute("data-motion");
    el.removeAttribute("data-dir");
    pendingWalk = false;
  };

  const createSwiperConfig = (counterEl: Element | null) => ({
    modules: [EffectFade, Navigation, Autoplay, Keyboard],
    effect: "fade" as const,
    fadeEffect: { crossFade: true },
    speed: 800,
    allowTouchMove: true,
    loop: true,
    autoplay: {
      delay: 8000,
      disableOnInteraction: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
    keyboard: { enabled: true },
    on: {
      beforeTransitionStart: (_swiper: Swiper, speed: number, internal?: boolean) => {
        // Autoplay calls slideNext(speed, true, true). User nav omits internal.
        // Loop corrections also pass internal but with speed 0 — ignore those.
        pendingWalk = Boolean(internal) && speed > 0;
      },
      slideNextTransitionStart: (swiper: Swiper) => applyMotion(swiper, "next"),
      slidePrevTransitionStart: (swiper: Swiper) => applyMotion(swiper, "prev"),
      transitionEnd: (swiper: Swiper) => clearMotion(swiper),
      slideChange: (swiper: Swiper) => {
        if (counterEl) {
          counterEl.textContent = (swiper.realIndex + 1).toString();
        }
      },
    },
  });

  const initSwiper = (): void => {
    destroySwiper();
    pendingWalk = false;

    const swiperContainer = document.querySelector(".showcase-swiper") as HTMLElement;
    if (!swiperContainer) return;

    if (swiperContainer.dataset.randomize === "true") {
      shuffleSlides(swiperContainer);
    }

    const counterEl = document.querySelector(".current-slide");
    swiperInstance = new Swiper(".showcase-swiper", createSwiperConfig(counterEl));
  };

  const setupSwiperInitialization = (): void => {
    document.addEventListener("astro:page-load", initSwiper);

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSwiper);
    } else {
      initSwiper();
    }
  };

  setupSwiperInitialization();
</script>

<style>
  :root {
    --swiper-navigation-size: 0;
    --frame-walnut: #4a3428;
    --frame-walnut-mid: #3a281e;
    --frame-walnut-dark: #241810;
    --frame-highlight: rgba(232, 210, 176, 0.28);
    --fillet-light: #d4bc8c;
    --fillet-mid: #b89562;
    --fillet-dark: #8a6a3e;
    --mat-paper: #f7f3ec;
    --mat-paper-edge: #e8dfd2;
  }

  .gallery-showcase {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .showcase-swiper {
    flex: 1;
    min-height: 0;
    width: 100%;
    position: relative;
    overflow: hidden;
  }

  .swiper-wrapper,
  .swiper-slide {
    height: 100%;
  }

  .swiper-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .slide-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 1.5rem 1rem 2.5rem;
  }

  .art-piece {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: min(90vw, 1100px);
    max-height: 100%;
    text-decoration: none;
    cursor: default;
    will-change: transform;
  }

  /* Walnut moulding with bevelled edges */
  .frame-outer {
    position: relative;
    padding: 13px;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, transparent 38%, rgba(0, 0, 0, 0.28) 100%),
      linear-gradient(90deg, rgba(255, 255, 255, 0.08) 0%, transparent 30%, rgba(0, 0, 0, 0.18) 100%),
      linear-gradient(145deg, #5c4334 0%, var(--frame-walnut) 32%, var(--frame-walnut-mid) 68%, var(--frame-walnut-dark) 100%);
    box-shadow:
      inset 0 1px 0 var(--frame-highlight),
      inset 0 -1px 0 rgba(0, 0, 0, 0.45),
      inset 1px 0 0 rgba(255, 255, 255, 0.1),
      inset -1px 0 0 rgba(0, 0, 0, 0.35),
      0 1px 2px rgba(89, 79, 66, 0.18),
      0 10px 20px rgba(89, 79, 66, 0.12),
      0 24px 48px rgba(89, 79, 66, 0.1);
  }

  .frame-outer::before {
    content: "";
    position: absolute;
    inset: 5px;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.35),
      inset 0 0 0 2px rgba(255, 255, 255, 0.07);
  }

  /* Thin brass fillet between wood and mat */
  .frame-fillet {
    padding: 3px;
    background: linear-gradient(145deg, var(--fillet-light) 0%, var(--fillet-mid) 42%, var(--fillet-dark) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  /* Paper mat (passe-partout) */
  .frame-mat {
    padding: clamp(14px, 2.8vw, 34px);
    background:
      linear-gradient(180deg, #fcfaf6 0%, var(--mat-paper) 55%, var(--mat-paper-edge) 100%);
    box-shadow: inset 0 0 0 1px rgba(90, 70, 50, 0.06);
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  /* Bevelled window cut into the mat */
  .frame-window {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #1a1816;
    box-shadow:
      1px 1px 0 rgba(255, 255, 255, 0.55),
      -1px -1px 0 rgba(160, 138, 112, 0.35),
      inset 2px 2px 3px rgba(0, 0, 0, 0.28),
      inset -1px -1px 2px rgba(255, 255, 255, 0.06);
  }

  .framed-photo {
    display: block;
    max-width: 100%;
    max-height: calc(100dvh - 16rem);
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Autoplay: walk along the wall. Explicit nav keeps Swiper's crossfade. */
  .showcase-swiper[data-motion="walk"] .swiper-slide-active,
  .showcase-swiper[data-motion="walk"] .swiper-slide-prev,
  .showcase-swiper[data-motion="walk"] .swiper-slide-next {
    opacity: 1 !important;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-next,
  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-prev {
    opacity: 0 !important;
    visibility: hidden;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-prev {
    z-index: 1;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-active {
    z-index: 2;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-next {
    z-index: 1;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-active {
    z-index: 2;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-prev .art-piece {
    animation: walk-out-left 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  .showcase-swiper[data-motion="walk"][data-dir="next"] .swiper-slide-active .art-piece {
    animation: walk-in-from-right 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-next .art-piece {
    animation: walk-out-right 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  .showcase-swiper[data-motion="walk"][data-dir="prev"] .swiper-slide-active .art-piece {
    animation: walk-in-from-left 1.25s cubic-bezier(0.45, 0.05, 0.15, 1) both;
  }

  @keyframes walk-out-left {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 5rem)); }
  }

  @keyframes walk-in-from-right {
    from { transform: translateX(calc(100% + 5rem)); }
    to { transform: translateX(0); }
  }

  @keyframes walk-out-right {
    from { transform: translateX(0); }
    to { transform: translateX(calc(100% + 5rem)); }
  }

  @keyframes walk-in-from-left {
    from { transform: translateX(calc(-100% - 5rem)); }
    to { transform: translateX(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .art-piece {
      animation: none !important;
    }
  }

  .slide-counter {
    position: absolute;
    bottom: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    font-family: "Oranienbaum", Georgia, serif;
    font-size: 0.875rem;
    letter-spacing: 0.15em;
    color: #a08a70;
    pointer-events: none;
    user-select: none;
  }

  .counter-separator {
    margin: 0 0.25em;
    opacity: 0.4;
  }

  .swiper-button-next::after,
  .swiper-button-prev::after {
    display: none;
  }

  .navigation-controls {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    background-color: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
    border: none;
    border-radius: 50%;
    min-width: 48px;
    min-height: 48px;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    pointer-events: auto;
    cursor: pointer;
  }

  .nav-arrow:hover {
    background-color: rgba(255, 255, 255, 0.5);
  }

  .swiper-button-prev {
    left: 1.5rem;
  }

  .swiper-button-next {
    right: 1.5rem;
  }

  .arrow-icon {
    width: 24px;
    height: 24px;
    color: #262626;
    flex-shrink: 0;
  }

  @media (max-width: 1024px) {
    .nav-arrow {
      min-width: 44px;
      min-height: 44px;
      width: 44px;
      height: 44px;
    }

    .arrow-icon {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 768px) {
    .nav-arrow {
      display: none !important;
    }

    .slide-stage {
      padding: 1rem 0.5rem 2rem;
    }

    .frame-outer {
      padding: 9px;
    }

    .frame-fillet {
      padding: 2px;
    }

    .framed-photo {
      max-height: calc(100dvh - 14rem);
    }
  }

  @media (min-height: 900px) {
    .framed-photo {
      max-height: calc(100dvh - 18rem);
    }
  }
</style>
