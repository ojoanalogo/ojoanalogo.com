---
import site from "../data/site.json";

interface NavLink {
  label: string;
  href: string;
  current?: boolean;
  external?: boolean;
}

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const [first, ...rest] = site.title.trim().split(/\s+/);
const last = rest.join(" ");

const links: NavLink[] = [
  { label: "álbumes", href: "/#albumes" },
  { label: "sobre mí", href: "/about", current: path === "/about" },
  { label: "mi otro yo", href: "https://alfon.so", external: true },
];
---

<header class="site-header">
  <a href="/" class="brand" aria-label={`${site.title} — inicio`}><span>{first}</span>{last && (<><span class="brand-dash" aria-hidden="true">—</span><span class="brand-last">{last}</span></>)}</a>

  <nav class="site-nav" aria-label="Principal">
    <ul>
      {
        links.map((link, i) => (
          <li><a
              class="link"
              href={link.href}
              aria-current={link.current ? "page" : undefined}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >{link.label}{link.external && <span class="arrow" aria-hidden="true">↗</span>}</a>{i < links.length - 1 && <span aria-hidden="true">,</span>}</li>
        ))
      }
    </ul>
  </nav>
</header>
