---
import type { NavId } from "../types/nav";
import Mark from "./Mark.astro";

export interface Props {
  title: string;
  active?: NavId;
  /** Show the shutter-click sound toggle (landing only). */
  showSound?: boolean;
}

const { title, active, showSound = false } = Astro.props;

const links: Array<{ id: NavId | "contact"; label: string; href: string; col: string }> = [
  { id: "index", label: "Índice", href: "/indice", col: "nav-col-index" },
  { id: "about", label: "Info", href: "/about", col: "nav-col-info" },
  { id: "contact", label: "Contacto", href: "mailto:hola@ojoanalogo.com", col: "nav-col-contact" },
];
---

<header class="site-header grid-12 page-pad" data-sound={showSound ? "true" : undefined}>
  <a
    href="/"
    class="brand"
    aria-label={`${title} — inicio`}
    aria-current={active === "home" ? "page" : undefined}
  >
    <Mark size={18} />
    <span>{title}</span>
  </a>

  {
    showSound && (
      <button
        type="button"
        class="sound-toggle link-quiet"
        data-sound-toggle
        aria-pressed="false"
      >
        <span class="sound-off">Activar sonido</span>
        <span class="sound-on">Silenciar</span>
      </button>
    )
  }

  <nav class="site-nav" aria-label="Principal">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["detent-chip", link.col]}
          aria-current={active === link.id ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    height: var(--header-h);
    align-items: center;
    white-space: nowrap;
  }

  .brand {
    grid-column: 1 / span 4;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    justify-self: start;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .sound-toggle {
    grid-column: 5 / span 3;
    justify-self: start;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .sound-toggle .sound-on,
  .sound-toggle[aria-pressed="true"] .sound-off {
    display: none;
  }

  .sound-toggle[aria-pressed="true"] .sound-on {
    display: inline;
  }

  /* nav spans the right half; its own 4-col sub-grid mirrors the page grid */
  .site-nav {
    grid-column: 8 / -1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
  }

  .site-nav a {
    justify-self: start;
  }

  .nav-col-index {
    grid-column: 2;
  }

  .nav-col-info {
    grid-column: 4;
  }

  .nav-col-contact {
    grid-column: 5;
    justify-self: end !important;
  }

  @media (max-width: 767px) {
    .site-header {
      display: flex;
      gap: 18px;
    }

    .brand {
      margin-right: auto;
    }

    .sound-toggle {
      display: none;
    }

    .site-nav {
      display: flex;
      gap: 16px;
    }
  }
</style>

<script>
  import { isSoundOn, setSoundOn } from "../scripts/shutter";

  const bind = () => {
    const button = document.querySelector<HTMLButtonElement>("[data-sound-toggle]");
    if (!button) return;

    const sync = () => button.setAttribute("aria-pressed", String(isSoundOn()));
    sync();

    button.addEventListener("click", () => {
      setSoundOn(!isSoundOn());
      sync();
    });
  };

  document.addEventListener("astro:page-load", bind);
</script>
