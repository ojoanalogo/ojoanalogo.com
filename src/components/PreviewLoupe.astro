---
/**
 * Preview loupe — top-down disc with rubber ocular + CSS-space optical glass.
 * Zoom is always 2× for now; 5× dial/wheel stays behind ZOOM_5X_ENABLED.
 */
---

<div
  class="ploupe"
  data-preview-loupe
  role="group"
  aria-label="Lupa Preview: arrastra para ampliar a 2×"
  data-zoom-5x="off"
  style="--pl-x: 0px; --pl-y: 0px; --pl-size: 168px"
>
  <div class="ploupe-shadow" aria-hidden="true"></div>

  <div class="ploupe-body">
    <div class="ploupe-support" aria-hidden="true"></div>
    <div class="ploupe-support-sheen" aria-hidden="true"></div>

    <canvas class="ploupe-glass" data-ploupe-glass width="280" height="280"></canvas>
    <div class="ploupe-flare" aria-hidden="true"></div>
    <div class="ploupe-glass-rim" aria-hidden="true"></div>

    <div class="ploupe-rubber" aria-hidden="true"></div>
    <svg class="ploupe-mark" viewBox="0 0 100 100" aria-hidden="true">
      <defs>
        <path id="ploupe-arc" d="M 16,76 A 40,40 0 0 0 84,76" fill="none"></path>
      </defs>
      <text>
        <textPath
          href="#ploupe-arc"
          xlink:href="#ploupe-arc"
          startOffset="50%"
          text-anchor="middle"
          data-ploupe-label
        >
          PREVIEW 2×
        </textPath>
      </text>
    </svg>

    <!-- 5× mode: hit target over PREVIEW engraving (hidden while disabled) -->
    <button
      type="button"
      class="ploupe-preview-hit"
      data-ploupe-preview-hit
      aria-label="Mostrar selector de aumento"
      aria-controls="ploupe-dial"
      hidden
    ></button>
  </div>

  <!-- 5× mode: zoom dial (hidden while disabled) -->
  <div class="ploupe-dial" id="ploupe-dial" role="group" aria-label="Aumento" data-ploupe-dial hidden>
    <span class="ploupe-dial-thumb" data-zoom-thumb aria-hidden="true"></span>
    <button type="button" class="ploupe-dial-btn" data-zoom-set="2" aria-pressed="true">2×</button>
    <button type="button" class="ploupe-dial-btn" data-zoom-set="5" aria-pressed="false">5×</button>
  </div>
</div>

<script>
  function initPreviewLoupe(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-ploupe-glass]")!;
    const ctx = canvas.getContext("2d", { alpha: true })!;
    const labelEl = root.querySelector<SVGTextPathElement>("[data-ploupe-label]")!;
    const dialBtns = [...root.querySelectorAll<HTMLButtonElement>("[data-zoom-set]")];

    const plate = document.createElement("canvas");
    const plateCtx = plate.getContext("2d", { willReadFrequently: true })!;
    const blit = document.createElement("canvas");
    const blitCtx = blit.getContext("2d")!;

    /** Flip to true to restore 5× + dial / wheel switching. */
    const ZOOM_5X_ENABLED = false;
    type ZoomMode = 2 | 5;
    const WARP = 128;
    const IOR = 0.24;
    /** Glass is inset 22% → 56% of the loupe disc (.ploupe-glass). */
    const GLASS_FRAC = 0.56;

    let zoom: ZoomMode = 2;
    let zoomVis = 2;
    let zoomRaf = 0;
    let sizeCss = 168;
    let dragging = false;
    let dirty = true;
    let warpSize = 0;
    let outBuf: ImageData | null = null;
    let lastKey = "";
    let raf = 0;
    let vw = window.innerWidth;
    let vh = window.innerHeight;
    let grabDX = 0;
    let grabDY = 0;
    let inLightbox = false;
    let glideTimer = 0;
    const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const fallBack =
      getComputedStyle(document.documentElement).getPropertyValue("--color-paper").trim() ||
      getComputedStyle(document.body).backgroundColor ||
      "#f5f5f5";

    function syncZoomUi() {
      if (labelEl) labelEl.textContent = `PREVIEW ${zoom}×`;
      root.dataset.zoom = String(zoom);
      for (const btn of dialBtns) {
        btn.setAttribute("aria-pressed", String(btn.dataset.zoomSet === String(zoom)));
      }
    }

    function setZoom(next: ZoomMode) {
      if (!ZOOM_5X_ENABLED && next !== 2) next = 2;
      if (next === zoom) return;
      zoom = next;
      syncZoomUi();
      if (!zoomRaf) tickZoom();
    }

    function tickZoom() {
      zoomRaf = requestAnimationFrame(() => {
        const diff = zoom - zoomVis;
        if (Math.abs(diff) < 0.02) {
          zoomVis = zoom;
          zoomRaf = 0;
        } else {
          zoomVis += diff * 0.38;
          tickZoom();
        }
        dirty = true;
        lastKey = "";
        schedule();
      });
    }

    function centre() {
      const h = homePos();
      return {
        x: parseFloat(root.style.getPropertyValue("--pl-x")) || h.x,
        y: parseFloat(root.style.getPropertyValue("--pl-y")) || h.y,
      };
    }

    /** Rest above the “Arrastra para explorar” HUD chip when present. */
    function homePos() {
      const hud = document.querySelector("[data-wall-coords]")?.closest(".chip");
      if (hud) {
        const r = hud.getBoundingClientRect();
        // During ClientRouter swaps the chip can briefly report 0×0 → (0,0).
        // Never treat that as home or we clamp into the top-left corner.
        if (r.width > 40 && r.height > 20 && r.bottom > 40 && r.right > 40) {
          return {
            x: r.left + r.width / 2,
            y: r.top - sizeCss * 0.55 - 40,
          };
        }
      }
      return { x: vw - 100, y: vh - 22 - sizeCss * 0.9 - 40 };
    }

    /** Snap/glide to home after layout is trustworthy (esp. post view-transition). */
    function goHome(glide = false) {
      syncSize();
      const apply = () => {
        const h = homePos();
        place(h.x, h.y, { glide });
      };
      apply();
      requestAnimationFrame(() => requestAnimationFrame(apply));
      window.setTimeout(apply, 120);
    }

    function place(x: number, y: number, opts: { clamp?: boolean; glide?: boolean } = {}) {
      const { clamp = true, glide = false } = opts;
      if (clamp) {
        const pad = sizeCss * 0.5;
        x = Math.max(pad, Math.min(vw - pad, x));
        y = Math.max(pad, Math.min(vh - pad, y));
      }
      if (glide && !reducedMotion()) {
        root.classList.add("is-gliding");
        window.clearTimeout(glideTimer);
        glideTimer = window.setTimeout(() => root.classList.remove("is-gliding"), 560);
      } else {
        root.classList.remove("is-gliding");
      }
      root.style.setProperty("--pl-x", `${x}px`);
      root.style.setProperty("--pl-y", `${y}px`);
      dirty = true;
      schedule();
    }

    /**
     * Sit just outside the fullscreen lightbox frame — bottom-right corner,
     * nudged further right so the glass is not on top of the photo.
     * Uses the layout rect from lightbox (FLIP-safe), not getBoundingClientRect.
     */
    function parkOnLightbox(rect?: { left: number; top: number; width: number; height: number }) {
      inLightbox = true;
      const r =
        rect && rect.width > 48
          ? rect
          : (() => {
              // Fallback: read target layout from inline styles (ignores FLIP transform).
              const img = document.querySelector<HTMLElement>("[data-lb-img]");
              if (!img) return null;
              const left = parseFloat(img.style.left);
              const top = parseFloat(img.style.top);
              const width = parseFloat(img.style.width);
              const height = parseFloat(img.style.height);
              if (![left, top, width, height].every((n) => Number.isFinite(n) && n > 0)) return null;
              return { left, top, width, height };
            })();

      if (r) {
        const right = r.left + r.width;
        const bottom = r.top + r.height;
        const roomRight = vw - right;
        if (roomRight > sizeCss * 0.5) {
          // Outside the frame, just past the bottom-right corner.
          place(right + sizeCss * 0.4, bottom - sizeCss * 0.18, { glide: true });
        } else {
          // Full-bleed width: hang under the bottom-right corner instead.
          place(right - sizeCss * 0.18, bottom + sizeCss * 0.4, { glide: true });
        }
      } else {
        place(vw - sizeCss * 0.45, vh * 0.62, { glide: true });
      }
    }

    /** Leave the preview — glide straight back to the wall resting spot. */
    function leaveLightbox() {
      if (!inLightbox) return;
      inLightbox = false;
      const h = homePos();
      place(h.x, h.y, { glide: !reducedMotion() });
    }

    function syncSize() {
      vw = window.innerWidth;
      vh = window.innerHeight;
      sizeCss = Math.min(180, Math.max(140, Math.round(vw * 0.14)));
      root.style.setProperty("--pl-size", `${sizeCss}px`);
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const px = Math.round(sizeCss * GLASS_FRAC * dpr);
      if (canvas.width !== px) {
        canvas.width = px;
        canvas.height = px;
        warpSize = 0;
        dirty = true;
      }
    }

    /** CSS diameter of the glass — optical zoom lives in CSS px (DPR / page-zoom safe). */
    function glassCss() {
      return canvas.clientWidth || sizeCss * GLASS_FRAC;
    }

    function imgUnder(cx: number, cy: number): HTMLImageElement | null {
      root.style.pointerEvents = "none";
      const stack = document.elementsFromPoint(cx, cy);
      root.style.pointerEvents = "";
      for (const el of stack) {
        if (el instanceof HTMLImageElement && el.naturalWidth > 0) return el;
        if (el instanceof HTMLElement) {
          const img = el.querySelector("img");
          if (img?.naturalWidth) return img;
        }
      }
      return null;
    }

    function ensureWarpBuffers(wSize: number) {
      if (warpSize === wSize) return;
      warpSize = wSize;
      plate.width = Math.ceil(wSize * 1.12);
      plate.height = plate.width;
      blit.width = wSize;
      blit.height = wSize;
      outBuf = ctx.createImageData(wSize, wSize);
    }

    function draw(img: HTMLImageElement | null, cx: number, cy: number) {
      const size = canvas.width;
      const R = size / 2;
      ensureWarpBuffers(WARP);
      const wSize = WARP;
      const plateN = plate.width;
      const pR = plateN / 2;
      const wR = wSize / 2;

      plateCtx.fillStyle = fallBack;
      plateCtx.fillRect(0, 0, plateN, plateN);

      if (img) {
        const rect = img.getBoundingClientRect();
        if (rect.width > 1 && rect.height > 1) {
          // True N× in CSS space; 1.12 pad feeds the refraction plate only.
          const srcCss = (glassCss() / zoomVis) * 1.12;
          const scaleX = img.naturalWidth / rect.width;
          const scaleY = img.naturalHeight / rect.height;
          const srcW = srcCss * scaleX;
          const srcH = srcCss * scaleY;
          try {
            plateCtx.drawImage(
              img,
              (cx - rect.left) * scaleX - srcW / 2,
              (cy - rect.top) * scaleY - srcH / 2,
              srcW,
              srcH,
              0,
              0,
              plateN,
              plateN,
            );
          } catch {
            /* unload / decode race */
          }
        }
      }

      let src: Uint8ClampedArray;
      try {
        src = plateCtx.getImageData(0, 0, plateN, plateN).data;
      } catch {
        // Cross-origin frame without CORS — leave the paper fill.
        ctx.clearRect(0, 0, size, size);
        ctx.fillStyle = fallBack;
        ctx.beginPath();
        ctx.arc(R, R, R - 0.5, 0, Math.PI * 2);
        ctx.fill();
        return;
      }
      const d = outBuf!.data;

      for (let y = 0; y < wSize; y++) {
        for (let x = 0; x < wSize; x++) {
          const dx = (x - wR) / wR;
          const dy = (y - wR) / wR;
          const r2 = dx * dx + dy * dy;
          const di = (y * wSize + x) * 4;
          if (r2 > 1) {
            d[di + 3] = 0;
            continue;
          }
          const r = Math.sqrt(r2);
          const h = Math.pow(1 - Math.pow(1 - r, 4), 0.25);
          const pull = 1 - IOR * h;
          const sx = pR + dx * pull * pR;
          const sy = pR + dy * pull * pR;
          const fringe = r2 * 2.2;
          const at = (ox: number, oy: number) => {
            const ix = Math.max(0, Math.min(plateN - 1, (sx + ox) | 0));
            const iy = Math.max(0, Math.min(plateN - 1, (sy + oy) | 0));
            return (iy * plateN + ix) * 4;
          };
          const iR = at(-fringe, 0);
          const iG = at(0, 0);
          const iB = at(fringe, 0);
          d[di] = src[iR];
          d[di + 1] = src[iG + 1];
          d[di + 2] = src[iB + 2];
          d[di + 3] = 255;
        }
      }

      ctx.clearRect(0, 0, size, size);
      ctx.save();
      ctx.beginPath();
      ctx.arc(R, R, R - 0.5, 0, Math.PI * 2);
      ctx.clip();
      blitCtx.putImageData(outBuf!, 0, 0);
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = "high";
      ctx.drawImage(blit, 0, 0, size, size);

      const vig = ctx.createRadialGradient(R * 0.7, R * 0.58, R * 0.12, R, R, R);
      vig.addColorStop(0, "rgba(255,255,255,0.12)");
      vig.addColorStop(0.5, "rgba(255,255,255,0)");
      vig.addColorStop(1, "rgba(18,16,12,0.22)");
      ctx.fillStyle = vig;
      ctx.fillRect(0, 0, size, size);
      ctx.restore();
    }

    function paint() {
      if (document.documentElement.dataset.view === "sequence") return;
      if (document.visibilityState !== "visible") return;
      if (!dirty && !dragging) return;

      const { x: cx, y: cy } = centre();
      const img = imgUnder(cx, cy);
      const rect = img?.getBoundingClientRect();
      const key = [
        zoomVis.toFixed(2),
        glassCss() | 0,
        cx | 0,
        cy | 0,
        img?.currentSrc ?? "",
        rect ? `${rect.left | 0},${rect.top | 0},${rect.width | 0}` : "",
      ].join("|");

      if (!dragging && key === lastKey) {
        dirty = false;
        return;
      }
      lastKey = key;
      dirty = false;
      draw(img, cx, cy);
    }

    function schedule() {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        paint();
      });
    }

    function onInvalidate() {
      // Coalesce with rAF — never sync-paint on every wall frame.
      dirty = true;
      lastKey = "";
      schedule();
    }

    root.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      if ((e.target as HTMLElement).closest(".ploupe-dial, .ploupe-preview-hit")) return;
      e.preventDefault();
      e.stopPropagation();
      const c = centre();
      grabDX = e.clientX - c.x;
      grabDY = e.clientY - c.y;
      dragging = true;
      dirty = true;
      root.classList.add("is-held");
      root.classList.remove("is-gliding");
      root.setPointerCapture(e.pointerId);
      schedule();
    });
    root.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      e.preventDefault();
      place(e.clientX - grabDX, e.clientY - grabDY);
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove("is-held");
      dirty = true;
      schedule();
      try {
        root.releasePointerCapture(e.pointerId);
      } catch {
        /* ok */
      }
    };
    root.addEventListener("pointerup", end);
    root.addEventListener("pointercancel", end);

    // ——— 5× mode (dormant while ZOOM_5X_ENABLED is false) ———
    root.addEventListener(
      "wheel",
      (e) => {
        if (!ZOOM_5X_ENABLED) return;
        e.preventDefault();
        e.stopPropagation();
        if (e.deltaY < 0 && zoom !== 5) setZoom(5);
        else if (e.deltaY > 0 && zoom !== 2) setZoom(2);
      },
      { passive: false },
    );
    root.addEventListener("click", (e) => {
      if (!ZOOM_5X_ENABLED) return;
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-zoom-set]");
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      setZoom(btn.dataset.zoomSet === "2" ? 2 : 5);
    });

    syncZoomUi();
    if (ZOOM_5X_ENABLED) {
      root.querySelector<HTMLElement>("[data-ploupe-preview-hit]")?.removeAttribute("hidden");
      root.querySelector<HTMLElement>("[data-ploupe-dial]")?.removeAttribute("hidden");
      root.dataset.zoom5x = "on";
    }

    const onViewport = () => {
      syncSize();
      const c = centre();
      place(c.x, c.y);
    };
    window.addEventListener("resize", onViewport);
    window.visualViewport?.addEventListener("resize", onViewport);
    window.visualViewport?.addEventListener("scroll", onInvalidate);
    window.addEventListener("scroll", onInvalidate, true);
    window.addEventListener("preview-loupe:invalidate", onInvalidate);
    window.addEventListener(
      "preview-loupe:lightbox",
      ((e: CustomEvent<{ open: boolean; rect?: { left: number; top: number; width: number; height: number } }>) => {
        if (e.detail?.open) parkOnLightbox(e.detail.rect);
        else leaveLightbox();
      }) as EventListener,
    );
    window.addEventListener(
      "preview-loupe:corner",
      ((e: CustomEvent<{ corner?: string }>) => {
        if (e.detail?.corner !== "tl") return;
        inLightbox = false;
        syncSize();
        // Top-left of the viewport, clear of the centered nav pill.
        const x = 20 + sizeCss * 0.5;
        const y = 20 + sizeCss * 0.5;
        place(x, y, { glide: true });
        onInvalidate();
      }) as EventListener,
    );
    window.addEventListener("lt:view", () => {
      dirty = true;
      schedule();
    });

    // Soft nav / view transitions: re-home once the new page finishes swapping.
    const onPageLoad = () => {
      if (!document.contains(root)) {
        window.removeEventListener("astro:page-load", onPageLoad);
        return;
      }
      inLightbox = false;
      goHome(false);
    };
    window.addEventListener("astro:page-load", onPageLoad);

    goHome(false);
  }

  const booted = new WeakSet<HTMLElement>();
  function boot() {
    const el = document.querySelector<HTMLElement>("[data-preview-loupe]");
    if (!el || booted.has(el)) return;
    booted.add(el);
    initPreviewLoupe(el);
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .ploupe {
    --pl-size: 168px;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 90;
    width: var(--pl-size);
    height: var(--pl-size);
    transform: translate3d(calc(var(--pl-x) - 50%), calc(var(--pl-y) - 50%), 0);
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    filter: drop-shadow(0 14px 24px rgba(0, 0, 0, 0.22)) drop-shadow(0 2px 4px rgba(0, 0, 0, 0.12));
    transition:
      filter 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }

  .ploupe:global(.is-gliding) {
    transition:
      transform 0.52s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.28s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s ease;
  }

  .ploupe:global(.is-held) {
    cursor: grabbing;
    filter: drop-shadow(0 20px 32px rgba(0, 0, 0, 0.28)) drop-shadow(0 4px 8px rgba(0, 0, 0, 0.14));
  }

  .ploupe-shadow {
    position: absolute;
    inset: 10% 8% -8%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 0.22), transparent 70%);
    pointer-events: none;
  }

  .ploupe-body {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }

  .ploupe-support {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 24%, rgba(255, 255, 255, 0.5) 0%, transparent 45%),
      rgba(150, 154, 162, 0.4);
    -webkit-backdrop-filter: blur(7px) saturate(1.05);
    backdrop-filter: blur(7px) saturate(1.05);
    box-shadow:
      inset 0 2px 4px rgba(255, 255, 255, 0.4),
      inset 0 -4px 8px rgba(0, 0, 0, 0.18),
      inset 0 0 0 1px rgba(255, 255, 255, 0.2);
    -webkit-mask: radial-gradient(farthest-side, transparent 52%, #000 53.5%);
    mask: radial-gradient(farthest-side, transparent 52%, #000 53.5%);
  }

  .ploupe-support-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(ellipse 55% 35% at 34% 26%, rgba(255, 255, 255, 0.45), transparent 62%);
    -webkit-mask: radial-gradient(farthest-side, transparent 52%, #000 53.5%);
    mask: radial-gradient(farthest-side, transparent 52%, #000 53.5%);
    mix-blend-mode: screen;
    opacity: 0.7;
  }

  .ploupe-glass {
    position: absolute;
    inset: 22%;
    width: 56%;
    height: 56%;
    border-radius: 50%;
    display: block;
    background: rgba(18, 18, 22, 0.25);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.14),
      inset 0 6px 14px rgba(0, 0, 0, 0.28);
  }

  .ploupe-glass-rim {
    position: absolute;
    inset: 21.5%;
    border-radius: 50%;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  .ploupe-flare {
    position: absolute;
    inset: 22%;
    border-radius: 50%;
    pointer-events: none;
    background:
      radial-gradient(36% 26% at 64% 28%, rgba(160, 205, 255, 0.5), transparent 70%),
      radial-gradient(40% 28% at 34% 30%, rgba(255, 255, 255, 0.45), transparent 65%);
    mix-blend-mode: screen;
    opacity: 0.85;
  }

  .ploupe-rubber {
    position: absolute;
    inset: 7%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, #3f3f3f 0%, #1a1a1a 42%, #0a0a0a 100%);
    box-shadow:
      inset 0 3px 6px rgba(255, 255, 255, 0.1),
      inset 0 -5px 10px rgba(0, 0, 0, 0.7),
      0 0 0 1px rgba(0, 0, 0, 0.45);
    -webkit-mask: radial-gradient(farthest-side, transparent 58%, #000 59.5%);
    mask: radial-gradient(farthest-side, transparent 58%, #000 59.5%);
  }

  .ploupe-mark {
    position: absolute;
    inset: 7%;
    width: auto;
    height: auto;
    pointer-events: none;
    overflow: visible;
  }

  .ploupe-mark text {
    fill: #9a9a9a;
    font-family: ui-sans-serif, system-ui, -apple-system, "Helvetica Neue", sans-serif;
    font-size: 4.4px;
    font-weight: 500;
    letter-spacing: 0.2em;
  }

  /* ——— 5× mode UI (dormant) ——— */
  .ploupe-preview-hit {
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: 6%;
    height: 24%;
    z-index: 4;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50% / 60%;
    background: transparent;
    cursor: pointer;
  }

  .ploupe-dial {
    position: absolute;
