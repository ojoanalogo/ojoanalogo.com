---
import CarouselGallery from "../components/CarouselGallery.astro";
import { getFeaturedPhotos } from "../data/featured";
import BaseLayout from "../layouts/BaseLayout.astro";

const photos = getFeaturedPhotos();
---

<BaseLayout sideBarActiveItemID="home" compactFooter>
  <div class="gallery-home flex-1 min-h-0 flex flex-col h-full">
    <div class="flex-1 min-h-0 w-full max-w-[96%] xl:max-w-[92%] 2xl:max-w-[88%] mx-auto flex flex-col">
      <CarouselGallery photos={photos} randomize={true} />
    </div>
  </div>
</BaseLayout>
