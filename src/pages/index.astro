---
import Filmstrip from "../components/Filmstrip.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLandingFrames } from "../utils/albums";

const frames = await getLandingFrames();
---

<BaseLayout active="home" fullscreen>
  {
    frames.length > 0 ? (
      <Filmstrip frames={frames} />
    ) : (
      <div class="empty page-pad">
        <h1 class="sr-only">Alfonso Reyes — ojoanalogo</h1>
        <p>
          Sin fotos en el carrusel todavía.
          <span class="label">
            Agrégalas desde{" "}
            <a class="underline underline-offset-4" href="/admin/" data-astro-reload>
              /admin
            </a>
            .
          </span>
        </p>
      </div>
    )
  }
</BaseLayout>

<style>
  .empty {
    flex: 1;
    display: grid;
    place-items: center;
    text-align: center;
  }
</style>
