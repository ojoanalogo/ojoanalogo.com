---
import AlbumCard from "../components/AlbumCard.astro";
import HeroReel from "../components/HeroReel.astro";
import { getFeaturedPhotos } from "../data/featured";
import { DEMO_PLACEHOLDERS, placeholderSet } from "../data/placeholders";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Photo } from "../types/photos";
import { getAlbums } from "../utils/albums";

const featured = getFeaturedPhotos();
const heroPhotos: Photo[] =
  featured.length > 0 || !DEMO_PLACEHOLDERS
    ? featured
    : placeholderSet().map((p) => ({ src: p.image, alt: p.alt ?? "" }));

const albums = await getAlbums();
---

<BaseLayout>
  <HeroReel photos={heroPhotos} caption="Fotógrafo analógico, ingeniero de software" />

  <section id="albumes" class="albums" aria-label="Álbumes">
    {
      albums.length > 0 ? (
        <div class="album-grid">
          {albums.map((album, i) => (
            <AlbumCard album={album} index={i} />
          ))}
        </div>
      ) : (
        <p class="albums-empty">Sin álbumes todavía.</p>
      )
    }
  </section>
</BaseLayout>
