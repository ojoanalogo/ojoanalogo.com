---
import ProximityWall from '../components/ProximityWall.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAlbums } from '../utils/albums';
import { homeWallPhotos } from '../utils/wallPhotos';

const photos = await homeWallPhotos(await getAlbums());
---

<BaseLayout title="404: Rollo no encontrado" canvas>
  {photos.length > 0 && <ProximityWall photos={photos} muted label="Muro de fotografías (fondo)" />}

  <div class="nf">
    <section class="nf-card">
      <p class="label-mono text-mute">Error 404 · Cuadro velado</p>
      <h1 class="nf-title">
        Rollo no<br /><span class="nf-mute">encontrado</span>
      </h1>
      <p class="nf-copy">La fotografía que buscas parece haberse perdido en el cuarto oscuro.</p>
      <a href="/" class="btn-ink">
        <svg viewBox="0 0 24 24" fill="none" class="w-4 h-4" aria-hidden="true">
          <path d="M19 12H5m6 6-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Volver al muro
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .nf {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: grid;
    place-items: center;
    padding: 16px;
    pointer-events: none;
  }

  .nf-card {
    display: grid;
    justify-items: start;
    gap: 16px;
    width: min(420px, 100%);
    padding: 28px 28px 26px;
    border-radius: 20px;
    background: var(--color-card);
    pointer-events: auto;
    box-shadow:
      rgb(0 0 0 / 0.34) 0 0.6px 0.6px -1.25px,
      rgb(0 0 0 / 0.3) 0 2.29px 2.29px -2.5px,
      rgb(0 0 0 / 0.12) 0 10px 10px -3.75px,
      rgb(0 0 0 / 0.08) 0 40px 80px -20px;
  }

  .nf-title {
    font-size: clamp(44px, 8vw, 64px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .nf-mute {
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--color-mute);
  }

  .nf-copy {
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }
</style>
