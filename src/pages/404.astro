---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Rollo velado" footer={false}>
  <section class="nf">
    <div class="panel hero-panel">
      <div class="hero-stage">
        <div class="nf-frame" role="img" aria-label="Fotograma velado por la luz">
          <span class="edge edge-tl mono">ojoanalogo ▸ 404</span>
          <span class="nf-title" aria-hidden="true">404</span>
          <span class="edge edge-br mono">▸ 24a</span>
        </div>
      </div>
      <a class="tab" href="/" data-dir="back">
        <span class="arrow" aria-hidden="true">←</span> volver al inicio
      </a>
    </div>

    <div class="nf-caption row">
      <h1>Rollo no encontrado</h1>
      <p>La fotografía que buscas parece haberse perdido en el cuarto oscuro.</p>
    </div>
  </section>
</BaseLayout>
