---
import Photo from "../components/Photo.astro";
import { DEMO_PLACEHOLDERS, DEMO_PORTRAIT } from "../data/placeholders";
import site from "../data/site.json";
import BaseLayout from "../layouts/BaseLayout.astro";

const portraitUrl = site.portraitUrl?.trim() || "";
const portrait = portraitUrl
  ? { src: portraitUrl, alt: "Alfonso Reyes — fotógrafo analógico", sample: false }
  : DEMO_PLACEHOLDERS
    ? { src: DEMO_PORTRAIT.image, alt: DEMO_PORTRAIT.alt ?? "", sample: true }
    : undefined;
---

<BaseLayout title="Sobre mí" footer={false}>
  <section class="about">
    <div class="about-text">
      <div class="about-copy" data-reveal>
        <p class="muted">Hola 👋</p>
        <p>
          Soy Alfonso Reyes,<br />
          ingeniero de software y fotógrafo.
        </p>
        <p>
          Mi medio favorito para tomar fotos es la fotografía análoga, pues
          encuentro fascinante el elemento sorpresa y la paciencia que conlleva,
          atributos que siento han estado desapareciendo a favor de experiencias
          efímeras y breves.
        </p>
        <p>{site.description}.</p>
      </div>

      <div class="about-links row">
        <nav aria-label="Redes">
          <a href="https://instagram.com/ojo.analogo/" target="_blank" rel="noreferrer">instagram</a>
          <a href="https://alfon.so" target="_blank" rel="noreferrer">mi otro yo</a>
        </nav>
        <a href="mailto:hola@ojoanalogo.com">hola@ojoanalogo.com</a>
      </div>
    </div>

    <figure class="about-portrait" data-reveal style="--i:1">
      {
        portrait && (
          <Photo
            src={portrait.src}
            alt={portrait.alt}
            sizes="(max-width: 900px) 100vw, 40vw"
            priority
          />
        )
      }
      {portrait?.sample && <figcaption class="mono">retrato de muestra</figcaption>}
    </figure>
  </section>
</BaseLayout>
