---
import IconInstagram from '../components/IconInstagram.astro';
import ProximityWall from '../components/ProximityWall.astro';
import site from '../data/site.json';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAlbums } from '../utils/albums';
import { homeWallPhotos } from '../utils/wallPhotos';

const portraitUrl = site.portraitUrl?.trim() || '';
const wallPhotos = portraitUrl ? [] : await homeWallPhotos(await getAlbums());
const aboutDescription =
  'Ingeniero de software y fotógrafo. Instantáneas analógicas — paciencia, sorpresa y grano.';
---

<BaseLayout
  title="Quién soy"
  description={aboutDescription}
  socialImagePath={portraitUrl || undefined}
  active="about"
>
  <section class="about">
    <div class="about-frame">
      {
        portraitUrl ? (
          <img
            class="about-portrait"
            src={portraitUrl}
            alt="Alfonso Reyes — fotógrafo analógico"
            width={800}
            height={1000}
            decoding="async"
          />
        ) : wallPhotos.length > 0 ? (
          <ProximityWall
            photos={wallPhotos}
            variant="contained"
            drift
            label="Muestra del archivo — arrastra para explorar"
          />
        ) : (
          <div class="about-portrait about-portrait--empty" aria-hidden="true" />
        )
      }
      <p class="about-frame-cap label-mono">
        {portraitUrl ? 'Retrato' : 'Archivo · arrastra para explorar'}
      </p>
    </div>

    <div class="about-copy">
      <p class="label-mono text-mute">Quién soy</p>
      <h1 class="about-title">
        Hola, soy<br />
        Alfonso Reyes.
      </h1>
      <p class="about-lede">Ingeniero de software y fotógrafo.</p>
      <p class="about-body">
        Mi medio favorito para tomar fotos es la fotografía análoga, pues encuentro fascinante el
        elemento sorpresa y la paciencia que conlleva, atributos que siento han estado
        desapareciendo a favor de experiencias efímeras y breves.
      </p>

      <div class="about-actions">
        <a
          class="btn-ink"
          href="https://www.instagram.com/ojo.analogo/"
          target="_blank"
          rel="noreferrer"
          aria-label="Instagram de ojo.analogo (se abre en una pestaña nueva)"
        >
          <IconInstagram class="h-4 w-4" />
          Instagram
        </a>
        <a class="btn-line" href="mailto:hola@ojoanalogo.com">Contáctame</a>
        <a
          class="about-other"
          href="https://alfon.so"
          target="_blank"
          rel="noreferrer"
          aria-label="alfon.so (se abre en una pestaña nueva)"
        >
          Mi otro yo ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 40px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 128px 24px 80px;
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 72px;
      min-height: 100dvh;
      padding-top: 120px;
    }
  }

  .about-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 560px;
    overflow: hidden;
    background: var(--color-paper-deep);
  }

  .about-frame :global(.wall) {
    background: var(--color-paper-deep);
  }

  .about-portrait {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-portrait--empty {
    background: var(--color-paper-deep);
  }

  .about-frame-cap {
    position: absolute;
    left: 12px;
    bottom: 12px;
    z-index: 2;
    padding: 5px 8px;
    border-radius: 7px;
    background: rgb(255 255 255 / 0.9);
    pointer-events: none;
  }

  .about-copy {
    display: grid;
    gap: 22px;
    align-content: center;
  }

  .about-title {
    font-size: clamp(48px, 7vw, 104px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-left: -0.04em;
  }

  .about-lede {
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .about-body {
    max-width: 52ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }

  .about-other {
    margin-left: 4px;
    font-size: 14px;
    color: var(--color-mute);
  }

  .about-other:hover {
    color: var(--color-ink);
  }
</style>
