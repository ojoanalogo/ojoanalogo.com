---
import { getCollection, render, type CollectionEntry } from "astro:content";
import type { CollectionsSchema } from "../../content.config";
import CollectionLayout from "../../layouts/CollectionLayout.astro";
import { getPhotoGlobal } from "../../utils/data.astro";

export async function getStaticPaths() {
  const postEntries = await getCollection("blog");
  return postEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const post: CollectionsSchema = entry.data;
const { Content } = await render(entry);

const photos = await getPhotoGlobal(entry.id.toString());

const featuredPhoto = await import(
  `../../content/blog/${entry.id}/assets/${entry.data.coverImage}.jpg`
);
---

<CollectionLayout
  title={post.title}
  tags={post.tags}
  description={post.description}
  publishDate={post.publishDate}
  updatedDate={post.updatedDate}
  socialImagePath={featuredPhoto.default.src}
  photos={photos}
>
  <Content />
</CollectionLayout>
