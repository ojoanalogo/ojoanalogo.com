---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import site from "../data/site.json";

export interface Props {
  title?: string;
  description?: string;
  socialImagePath?: string;
  /** Full-viewport pages (album, about, 404) carry contact info inline. */
  footer?: boolean;
}

const {
  socialImagePath,
  title = site.title,
  description = site.description,
  footer = true,
} = Astro.props;

const fullTitle = title === site.title ? site.title : `${title} — ${site.title}`;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={fullTitle}
      description={description}
      socialImagePath={socialImagePath}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header />
    <main id="main" class="flex flex-1 flex-col">
      <slot />
    </main>
    {footer && <Footer />}
  </body>
</html>

<script>
  let observer: IntersectionObserver | undefined;

  const reduceMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /** Fade/slide elements in as they enter the viewport (Framer-style appear). */
  function initReveal() {
    observer?.disconnect();
    const els = document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-in)");
    if (!els.length) return;

    if (reduceMotion() || !("IntersectionObserver" in window)) {
      els.forEach((el) => el.classList.add("is-in"));
      return;
    }

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer?.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -6% 0px", threshold: 0.08 },
    );
    els.forEach((el) => observer?.observe(el));
  }

  /**
   * FSLightbox injects its <style class="fslightbox-styles"> into <head> once,
   * and scans the DOM once. Astro's ClientRouter drops unknown head nodes on
   * every swap, so keep a handle on the style, restore it, and re-scan.
   */
  let lightboxStyles: HTMLStyleElement | null = null;

  function refreshLightbox() {
    lightboxStyles ??= document.head.querySelector<HTMLStyleElement>("style.fslightbox-styles");
    if (lightboxStyles && !lightboxStyles.isConnected) {
      document.head.appendChild(lightboxStyles);
    }
    const w = window as typeof window & { refreshFsLightbox?: () => void };
    w.refreshFsLightbox?.();
  }

  document.addEventListener("astro:page-load", () => {
    initReveal();
    refreshLightbox();
  });
</script>
