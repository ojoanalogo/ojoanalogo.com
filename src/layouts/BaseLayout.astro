---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import NavPill from '../components/NavPill.astro';
import PreviewLoupe from '../components/PreviewLoupe.astro';
import site from '../data/site.json';

export interface Props {
  title?: string;
  description?: string;
  socialImagePath?: string;
  /** Highlights the matching menu entry: 'home' | 'about' | album slug. */
  active?: string;
  /** Full-screen wall page: no document scroll, no footer. */
  canvas?: boolean;
  /** Preview loupe — only on the home wall and album walls. */
  loupe?: boolean;
}

const {
  title = site.title,
  description = site.description,
  socialImagePath,
  active,
  canvas = false,
  loupe = false,
} = Astro.props;
---

<!doctype html>
<html lang="es" class:list={[canvas && 'is-canvas']}>
  <head>
    <BaseHead title={title} description={description} socialImagePath={socialImagePath} />
  </head>
  <body>
    <a href="#main" class="skip-link chip">Saltar al contenido</a>
    <NavPill active={active} loupe={loupe} />
    <main id="main">
      <slot />
    </main>
    {!canvas && <Footer />}
    <Lightbox />
    {loupe && <PreviewLoupe />}
  </body>
</html>
