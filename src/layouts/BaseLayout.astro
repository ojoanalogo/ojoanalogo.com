---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import site from "../data/site.json";
import type { NavId } from "../types/nav";

export interface Props {
  title?: string;
  description?: string;
  socialImagePath?: string;
  active?: NavId;
  /** Full-viewport stage with no footer (landing). */
  fullscreen?: boolean;
}

const {
  socialImagePath,
  title = site.title,
  description = site.description,
  active,
  fullscreen = false,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={title}
      description={description}
      socialImagePath={socialImagePath}
    />
  </head>
  <body class:list={["site", fullscreen && "is-fullscreen"]}>
    <a class="skip-link" href="#main">Saltar al contenido</a>
    <Header title={site.title} active={active} showSound={fullscreen} />
    <main id="main" class="site-main">
      <slot />
    </main>
    {!fullscreen && <Footer />}
  </body>
</html>

<style>
  .site {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
  }

  .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .site.is-fullscreen {
    height: 100dvh;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .skip-link {
    position: absolute;
    left: var(--gutter);
    top: -40px;
    z-index: 50;
    background: var(--color-kodak);
    padding: 2px 6px;
  }

  .skip-link:focus {
    top: 8px;
  }
</style>
