# Copy values into public/admin/config.yml → media_libraries.cloudflare_r2
# (Sveltia config is client-side; these are not read by Astro at build time.)

# Cloudflare dashboard → R2 → account ID
CLOUDFLARE_ACCOUNT_ID=

# R2 API token → Access Key ID (Secret Access Key is entered in the CMS UI only)
R2_ACCESS_KEY_ID=

# Bucket name
R2_BUCKET=ojoanalogo-media

# Public URL: https://pub-xxxx.r2.dev  or  https://media.ojoanalogo.com
R2_PUBLIC_URL=

# Optional: Sveltia CMS Authenticator Worker URL (OAuth)
# SVELTIA_AUTH_BASE_URL=https://your-worker.workers.dev
